---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SoftwareCard from '../components/SoftwareCard.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Software" description="Open-source tools for immune repertoire analysis and more.">
  <h1>Software</h1>
  <p class="lede">Everything here is open source. Issues and pull requests are welcome.</p>
  <div class="cards">{projects.map((p) => <SoftwareCard project={p} />)}</div>
</BaseLayout>
<style>
  .lede { color: var(--muted); margin-bottom: var(--space-6); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: var(--space-4); }
</style>
