---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PublicationItem from '../components/PublicationItem.astro';
import SoftwareCard from '../components/SoftwareCard.astro';
import NewsList from '../components/NewsList.astro';
import { byDateDesc } from '../lib/format';
import { withBase } from '../lib/url';

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('Missing profile');
const selected = (await getCollection('publications', (p) => p.data.selected)).sort((a, b) => b.data.year - a.data.year);
const featured = (await getCollection('projects', (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news')).sort(byDateDesc).slice(0, 5);

const sameAs = Object.values(profile.data.links).filter(Boolean);
const site = Astro.site?.toString() ?? '';
const person = {
  '@type': 'Person',
  '@id': `${site}#person`,
  name: profile.data.name,
  givenName: 'Thomas',
  familyName: 'Konstantinovsky',
  alternateName: ['Thomas Konstantinovsky', 'T. Konstantinovsky'],
  jobTitle: 'PhD candidate',
  description: profile.data.shortBio,
  email: `mailto:${profile.data.email}`,
  image: {
    '@type': 'ImageObject',
    url: new URL(withBase('/images/portrait.jpg'), Astro.site).toString(),
    caption: profile.data.name,
    width: 800,
    height: 800,
  },
  url: site,
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Bar-Ilan University', url: 'https://www.biu.ac.il/' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Bar-Ilan University' },
    { '@type': 'CollegeOrUniversity', name: 'Holon Institute of Technology' },
  ],
  knowsAbout: profile.data.researchInterests,
  sameAs,
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${site}#profile`,
  url: site,
  name: profile.data.name,
  mainEntity: person,
};
---

<BaseLayout title={profile.data.name} ogType="profile" jsonLd={jsonLd}>
  <Hero profile={profile} />

  <SectionHeading number="01" title="Selected publications" />
  {selected.map((pub) => <PublicationItem pub={pub} compact />)}
  <p class="more"><a href={withBase('publications/')}>All publications →</a></p>

  <SectionHeading number="02" title="Software" />
  <div class="cards">{featured.map((p) => <SoftwareCard project={p} />)}</div>
  <p class="more"><a href={withBase('software/')}>All software →</a></p>

  <SectionHeading number="03" title="News" />
  <NewsList items={news} />
</BaseLayout>

<style>
  .more { margin-block: var(--space-4) 0; font-size: var(--text-sm); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: var(--space-4); }
</style>
