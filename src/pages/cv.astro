---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';

const profile = await getEntry('profile', 'profile');
const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const education = (await getCollection('education')).sort(byOrder);
const experience = (await getCollection('experience')).sort(byOrder);
---

<BaseLayout title="CV">
  <h1>Curriculum Vitae</h1>
  {profile?.data.cvPdf && <p><a href={withBase(profile.data.cvPdf)}>Download PDF</a></p>}

  <h2>Education</h2>
  <ul>
    {education.map(({ data }) => (
      <li>{data.degree} in {data.field}, {data.institution}</li>
    ))}
  </ul>

  <h2>Experience</h2>
  <ul>
    {experience.map(({ data }) => (
      <li>{data.role}, {data.organization}</li>
    ))}
  </ul>
</BaseLayout>
