---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import portrait from '../assets/images/speaking-auditorium.jpg';

const profile = await getEntry('profile', 'profile');
const areas = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const pubs = await getCollection('publications');
const projects = await getCollection('projects');
const pubById = new Map(pubs.map((p) => [p.id, p]));
const projById = new Map(projects.map((p) => [p.id, p]));
---

<BaseLayout title="Research" description="Probabilistic modeling, machine learning and algorithm design for large biological data, applied to the adaptive immune system.">
  <section class="intro">
    <div>
      <h1>Research</h1>
      <p>
        My research combines probabilistic modeling, machine learning and algorithm design to make
        large biological data tractable. I build probabilistic and graph-based models of biological
        sequence collections, design algorithms that search and compress enormous sequence spaces
        efficiently, train
        machine-learning and deep-learning models where a closed-form answer is out of reach, and
        write simulators with full ground truth to test all of the above.
      </p>
      <ul class="interests">{profile?.data.researchInterests.map((i) => <li class="mono">{i}</li>)}</ul>
    </div>
    <Image src={portrait} alt="Thomas Konstantinovsky speaking to a conference audience" width={800} class="portrait" />
  </section>


  <h2 class="areas-head">Research interests <span class="mono count">{areas.length}</span></h2>
  <div class="areas">
    {areas.map((area, i) => {
      const papers = area.data.publications.map((id) => pubById.get(id)).filter((p): p is NonNullable<typeof p> => Boolean(p));
      const tools = area.data.software.map((id) => projById.get(id)).filter((p): p is NonNullable<typeof p> => Boolean(p));
      return (
        <details class="row" id={area.id}>
          <summary>
            <span class="mono num">{String(i + 1).padStart(2, '0')}</span>
            <span class="text">
              <span class="title">{area.data.title}</span>
              <span class="summary">{area.data.summary}</span>
            </span>
            <span class="chev" aria-hidden="true"></span>
          </summary>
          <div class="body">
            <p>{area.data.body}</p>
            {(papers.length > 0 || tools.length > 0) && (
              <dl class="refs">
                {papers.length > 0 && (
                  <>
                    <dt class="mono">Papers</dt>
                    <dd>{papers.map((p) => <a href={`${withBase('publications/')}#${p.id}`}>{p.data.title}</a>)}</dd>
                  </>
                )}
                {tools.length > 0 && (
                  <>
                    <dt class="mono">Software</dt>
                    <dd>{tools.map((p) => <a href={`${withBase('software/')}#${p.id}`}>{p.data.name}</a>)}</dd>
                  </>
                )}
              </dl>
            )}
          </div>
        </details>
      );
    })}
  </div>
</BaseLayout>

<style>
  .intro { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--space-7); align-items: start; margin-bottom: var(--space-6); }
  .intro h1 { margin-bottom: var(--space-4); }
  .interests { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); }
  .portrait { border-radius: var(--radius); }

  .areas-head { display: flex; align-items: baseline; gap: var(--space-3); font-size: var(--text-lg); font-variation-settings: 'SOFT' 100, 'opsz' 24; padding-bottom: var(--space-3); border-bottom: 2px solid var(--ink); }
  .count { color: var(--muted); }
  .row { border-bottom: 1px solid var(--rule); scroll-margin-top: var(--space-6); }
  summary {
    display: grid; grid-template-columns: 3.5rem minmax(0, 1fr) 1rem; column-gap: var(--space-4); align-items: baseline;
    padding: var(--space-4) var(--space-2); margin-inline: calc(-1 * var(--space-2)); border-radius: 8px; cursor: pointer; list-style: none;
    transition: background-color var(--ease);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: var(--accent-soft); }
  summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .num { color: var(--accent); }
  .text { display: grid; gap: 0.15rem; }
  .title { font-weight: 600; font-size: var(--text-base); line-height: 1.35; }
  .summary { color: var(--muted); font-size: var(--text-sm); }
  .chev { width: 0.5rem; height: 0.5rem; border-right: 1.5px solid var(--muted); border-bottom: 1.5px solid var(--muted); transform: rotate(45deg); transition: transform var(--ease); justify-self: end; margin-top: -0.2rem; }
  .row[open] .chev { transform: rotate(-135deg); margin-top: 0.2rem; }
  .body { padding: var(--space-2) 0 var(--space-5) calc(3.5rem + var(--space-4)); }
  .body p { font-size: var(--text-sm); }
  .refs { display: grid; grid-template-columns: max-content 1fr; gap: var(--space-2) var(--space-4); margin: 0; font-size: var(--text-sm); }
  .refs dd { margin: 0; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-1); }
  @media (max-width: 720px) {
    .intro { grid-template-columns: minmax(0, 1fr); }
    summary { grid-template-columns: minmax(0, 1fr) 1rem; row-gap: var(--space-1); }
    .num { grid-column: 1; }
    .text { grid-column: 1; }
    .chev { grid-column: 2; grid-row: 1; }
    .body { padding-left: 0; }
  }
</style>
