---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { withBase } from '../lib/url';
import portrait from '../assets/images/speaking-closeup.jpg';

const profile = await getEntry('profile', 'profile');
const areas = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const pubs = await getCollection('publications');
const projects = await getCollection('projects');
const pubById = new Map(pubs.map((p) => [p.id, p]));
const projById = new Map(projects.map((p) => [p.id, p]));
---

<BaseLayout title="Research" description="Research areas: immune repertoire representation, deep learning for receptor alignment, simulation and benchmarking, string algorithms.">
  <section class="intro">
    <div>
      <h1>Research</h1>
      <p>
        My work asks how to represent, align and simulate adaptive immune receptor repertoires so that
        their statistics can be computed exactly and methods can be evaluated against known ground
        truth. It runs along four threads.
      </p>
      <ul class="interests">{profile?.data.researchInterests.map((i) => <li class="mono">{i}</li>)}</ul>
    </div>
    <Image src={portrait} alt="Thomas Konstantinovsky giving a talk" width={640} class="portrait" />
  </section>

  {areas.map((area, i) => (
    <section>
      <SectionHeading number={String(i + 1).padStart(2, '0')} title={area.data.title} id={area.id} />
      <div class="grid">
        <span />
        <div>
          <p class="summary">{area.data.summary}</p>
          <p>{area.data.body}</p>
          <dl class="refs">
            {area.data.publications.length > 0 && (
              <>
                <dt class="mono">Papers</dt>
                <dd>
                  {area.data.publications
                    .map((id) => pubById.get(id))
                    .filter((p): p is NonNullable<typeof p> => Boolean(p))
                    .map((p) => <a href={`${withBase('publications/')}#${p.id}`}>{p.data.title}</a>)}
                </dd>
              </>
            )}
            {area.data.software.length > 0 && (
              <>
                <dt class="mono">Software</dt>
                <dd>
                  {area.data.software
                    .map((id) => projById.get(id))
                    .filter((p): p is NonNullable<typeof p> => Boolean(p))
                    .map((p) => <a href={`${withBase('software/')}#${p.id}`}>{p.data.name}</a>)}
                </dd>
              </>
            )}
          </dl>
        </div>
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .intro { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--space-7); align-items: start; margin-bottom: var(--space-7); }
  .intro h1 { margin-bottom: var(--space-4); }
  .interests { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); }
  .portrait { border-radius: var(--radius); }
  .summary { font-family: var(--font-display); font-size: var(--text-lg); font-variation-settings: 'SOFT' 100; }
  .refs { display: grid; grid-template-columns: max-content 1fr; gap: var(--space-2) var(--space-4); margin: 0; font-size: var(--text-sm); }
  .refs dd { margin: 0; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-1); }
  @media (max-width: 720px) { .intro { grid-template-columns: minmax(0, 1fr); } }
</style>
