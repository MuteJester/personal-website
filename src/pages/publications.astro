---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PublicationItem from '../components/PublicationItem.astro';

const all = await getCollection('publications');
const inPrep = all.filter((p) => p.data.status === 'in-preparation');
const rest = all.filter((p) => p.data.status !== 'in-preparation');
const byYear = (a: (typeof all)[number], b: (typeof all)[number]) =>
  b.data.year - a.data.year || a.data.title.localeCompare(b.data.title);
const SELF = 'Thomas Konstantinovsky';
const leadAuthor = (p: (typeof all)[number]) => {
  const i = p.data.authors.indexOf(SELF);
  return i === 0 || (i === 1 && p.data.equalContribution);
};
const first = rest.filter(leadAuthor).sort(byYear);
const other = rest.filter((p) => !leadAuthor(p)).sort(byYear);
---

<BaseLayout title="Publications" description="Papers and preprints by Thomas Konstantinovsky.">
  <h1>Publications</h1>
  <p class="lede">† marks joint first authorship. PDFs are the open-access versions of record.</p>

  {inPrep.length > 0 && (
    <>
      <SectionHeading number="00" title="In preparation" />
      {inPrep.map((pub) => <PublicationItem pub={pub} />)}
    </>
  )}

  <SectionHeading number="01" title="Papers and preprints" />
  {first.map((pub) => <PublicationItem pub={pub} />)}

  <SectionHeading number="02" title="Other publications" />
  {other.map((pub) => <PublicationItem pub={pub} compact />)}
</BaseLayout>

<style>
  .lede { color: var(--muted); margin-bottom: var(--space-6); }
</style>
