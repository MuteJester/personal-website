---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationRow from '../components/PublicationRow.astro';
import { isLeadAuthor } from '../lib/format';

const SELF = 'Thomas Konstantinovsky';
const profile = await getEntry('profile', 'profile');
const all = await getCollection('publications');
type Pub = (typeof all)[number];
const byYear = (a: Pub, b: Pub) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title);
const leadAuthor = (p: Pub) => isLeadAuthor(p.data.authors, p.data.equalContribution, p.data.equalContributors, SELF);
const published = all.filter((p) => p.data.status !== 'in-preparation');
const first = published.filter((p) => leadAuthor(p) && p.data.year >= 2022).sort(byYear);
const earlier = published.filter((p) => leadAuthor(p) && p.data.year < 2022).sort(byYear);
const coauthored = published.filter((p) => !leadAuthor(p)).sort(byYear);
const inPrep = all.filter((p) => p.data.status === 'in-preparation').sort(byYear);

const site = Astro.site?.toString() ?? '';
const personId = `${site}#person`;
const articles = published.map((p) => ({
  '@type': 'ScholarlyArticle',
  '@id': `${site}publications/#${p.id}`,
  headline: p.data.title,
  name: p.data.title,
  datePublished: String(p.data.year),
  isPartOf: { '@type': 'Periodical', name: p.data.venue },
  author: p.data.authors.map((name) =>
    name === SELF ? { '@type': 'Person', '@id': personId, name } : { '@type': 'Person', name },
  ),
  ...(p.data.doi && { sameAs: `https://doi.org/${p.data.doi}`, identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: p.data.doi } }),
  ...(p.data.arxiv && { sameAs: `https://arxiv.org/abs/${p.data.arxiv}` }),
  ...(p.data.abstract && { abstract: p.data.abstract }),
}));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${site}publications/`,
  name: 'Publications',
  about: { '@type': 'Person', '@id': personId, name: SELF },
  hasPart: articles,
};
---

<BaseLayout title="Publications" description="Papers and preprints by Thomas Konstantinovsky." jsonLd={jsonLd}>
  <h1>Publications</h1>
  <p class="lede">
    Click a title for authors, abstract and links. † joint first authors.
    {profile?.data.links.scholar && <>{' '}Full list on <a href={profile.data.links.scholar} rel="noopener">Google Scholar</a>.</>}
  </p>

  <section class="group">
    <h2><span>First-author papers</span><span class="mono count">{first.length}</span></h2>
    {first.map((pub) => <PublicationRow pub={pub} />)}
  </section>

  <section class="group">
    <h2><span>Co-authored papers</span><span class="mono count">{coauthored.length}</span></h2>
    {coauthored.map((pub) => <PublicationRow pub={pub} />)}
  </section>

  {earlier.length > 0 && (
    <section class="group">
      <h2><span>Earlier work</span><span class="mono count">{earlier.length}</span></h2>
      {earlier.map((pub) => <PublicationRow pub={pub} />)}
    </section>
  )}

  {inPrep.length > 0 && (
    <section class="group">
      <h2><span>In preparation</span><span class="mono count">{inPrep.length}</span></h2>
      {inPrep.map((pub) => <PublicationRow pub={pub} />)}
    </section>
  )}
</BaseLayout>

<style>
  .lede { color: var(--muted); margin-bottom: var(--space-6); }
  .group { margin-top: var(--space-7); }
  .group h2 {
    display: flex; align-items: baseline; gap: var(--space-3);
    font-size: var(--text-lg); font-variation-settings: 'SOFT' 100, 'opsz' 24;
    padding-bottom: var(--space-3); margin-bottom: var(--space-1);
    border-bottom: 2px solid var(--ink);
  }
  .count { color: var(--muted); }
</style>
