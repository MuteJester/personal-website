---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PublicationItem from '../components/PublicationItem.astro';

const all = await getCollection('publications');
const inPrep = all.filter((p) => p.data.status === 'in-preparation');
const rest = all.filter((p) => p.data.status !== 'in-preparation');
const byYear = (a: (typeof all)[number], b: (typeof all)[number]) =>
  b.data.year - a.data.year || a.data.title.localeCompare(b.data.title);
const SELF = 'Thomas Konstantinovsky';
const leadAuthor = (p: (typeof all)[number]) => {
  const i = p.data.authors.indexOf(SELF);
  return i === 0 || (i === 1 && p.data.equalContribution);
};
const first = rest.filter(leadAuthor).sort(byYear);
const other = rest.filter((p) => !leadAuthor(p)).sort(byYear);

const site = Astro.site?.toString() ?? '';
const personId = `${site}#person`;
const articles = rest.map((p) => ({
  '@type': 'ScholarlyArticle',
  '@id': `${site}publications/#${p.id}`,
  headline: p.data.title,
  name: p.data.title,
  datePublished: String(p.data.year),
  isPartOf: { '@type': 'Periodical', name: p.data.venue },
  author: p.data.authors.map((name) =>
    name === SELF ? { '@type': 'Person', '@id': personId, name } : { '@type': 'Person', name },
  ),
  ...(p.data.doi && { sameAs: `https://doi.org/${p.data.doi}`, identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: p.data.doi } }),
  ...(p.data.arxiv && { sameAs: `https://arxiv.org/abs/${p.data.arxiv}` }),
  ...(p.data.abstract && { abstract: p.data.abstract }),
}));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${site}publications/`,
  name: 'Publications',
  about: { '@type': 'Person', '@id': personId, name: SELF },
  hasPart: articles,
};
---

<BaseLayout title="Publications" description="Papers and preprints by Thomas Konstantinovsky." jsonLd={jsonLd}>
  <h1>Publications</h1>
  <p class="lede">† marks joint first authorship. PDFs are the open-access versions of record.</p>

  {inPrep.length > 0 && (
    <>
      <SectionHeading number="00" title="In preparation" />
      {inPrep.map((pub) => <PublicationItem pub={pub} />)}
    </>
  )}

  <SectionHeading number="01" title="Papers and preprints" />
  {first.map((pub) => <PublicationItem pub={pub} />)}

  <SectionHeading number="02" title="Other publications" />
  {other.map((pub) => <PublicationItem pub={pub} compact />)}
</BaseLayout>

<style>
  .lede { color: var(--muted); margin-bottom: var(--space-6); }
</style>
