---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PublicationItem from '../components/PublicationItem.astro';

const SELF = 'Thomas Konstantinovsky';
const profile = await getEntry('profile', 'profile');
const all = await getCollection('publications');
type Pub = (typeof all)[number];
const byYear = (a: Pub, b: Pub) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title);
const leadAuthor = (p: Pub) => {
  const i = p.data.authors.indexOf(SELF);
  return i === 0 || (i === 1 && p.data.equalContribution);
};
const published = all.filter((p) => p.data.status !== 'in-preparation');
const first = published.filter((p) => leadAuthor(p) && p.data.year >= 2022).sort(byYear);
const earlier = published.filter((p) => leadAuthor(p) && p.data.year < 2022).sort(byYear);
const coauthored = published.filter((p) => !leadAuthor(p)).sort(byYear);
const inPrep = all.filter((p) => p.data.status === 'in-preparation').sort(byYear);

const site = Astro.site?.toString() ?? '';
const personId = `${site}#person`;
const articles = published.map((p) => ({
  '@type': 'ScholarlyArticle',
  '@id': `${site}publications/#${p.id}`,
  headline: p.data.title,
  name: p.data.title,
  datePublished: String(p.data.year),
  isPartOf: { '@type': 'Periodical', name: p.data.venue },
  author: p.data.authors.map((name) =>
    name === SELF ? { '@type': 'Person', '@id': personId, name } : { '@type': 'Person', name },
  ),
  ...(p.data.doi && { sameAs: `https://doi.org/${p.data.doi}`, identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: p.data.doi } }),
  ...(p.data.arxiv && { sameAs: `https://arxiv.org/abs/${p.data.arxiv}` }),
  ...(p.data.abstract && { abstract: p.data.abstract }),
}));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${site}publications/`,
  name: 'Publications',
  about: { '@type': 'Person', '@id': personId, name: SELF },
  hasPart: articles,
};
---

<BaseLayout title="Publications" description="Papers and preprints by Thomas Konstantinovsky." jsonLd={jsonLd}>
  <h1>Publications</h1>
  <p class="lede">
    † joint first authors. PDFs are open-access or author copies.
    {profile?.data.links.scholar && <>{' '}Full list on <a href={profile.data.links.scholar} rel="noopener">Google Scholar</a>.</>}
  </p>

  <SectionHeading title="First-author papers" />
  {first.map((pub) => <PublicationItem pub={pub} />)}

  <SectionHeading title="Co-authored papers" />
  {coauthored.map((pub) => <PublicationItem pub={pub} compact />)}

  {earlier.length > 0 && (
    <>
      <SectionHeading title="Earlier work" />
      {earlier.map((pub) => <PublicationItem pub={pub} compact />)}
    </>
  )}

  {inPrep.length > 0 && (
    <>
      <SectionHeading title="In preparation" />
      {inPrep.map((pub) => <PublicationItem pub={pub} compact />)}
    </>
  )}
</BaseLayout>

<style>
  .lede { color: var(--muted); margin-bottom: var(--space-4); }
</style>
