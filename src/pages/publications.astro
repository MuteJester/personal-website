---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationRow from '../components/PublicationRow.astro';
import { isLeadAuthor } from '../lib/format';

const SELF = 'Thomas Konstantinovsky';
const profile = await getEntry('profile', 'profile');
const all = await getCollection('publications');
type Pub = (typeof all)[number];
const byYear = (a: Pub, b: Pub) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title);
const leadAuthor = (p: Pub) => isLeadAuthor(p.data.authors, p.data.equalContribution, p.data.equalContributors, SELF);
const published = all.filter((p) => p.data.status !== 'in-preparation');
const first = published.filter((p) => leadAuthor(p) && p.data.year >= 2022).sort(byYear);
const earlier = published.filter((p) => leadAuthor(p) && p.data.year < 2022).sort(byYear);
const coauthored = published.filter((p) => !leadAuthor(p)).sort(byYear);
const inPrep = all.filter((p) => p.data.status === 'in-preparation').sort(byYear);
const journalArticles = all.filter((p) => p.data.type === 'journal' && p.data.status === 'published');
const journalCounts = new Map<string, { count: number; latestYear: number }>();
for (const { data } of journalArticles) {
  const existing = journalCounts.get(data.venue);
  journalCounts.set(data.venue, {
    count: (existing?.count ?? 0) + 1,
    latestYear: Math.max(existing?.latestYear ?? data.year, data.year),
  });
}
const journals = [...journalCounts].sort(
  ([nameA, a], [nameB, b]) => b.count - a.count || b.latestYear - a.latestYear || nameA.localeCompare(nameB),
);

const site = Astro.site?.toString() ?? '';
const personId = `${site}#person`;
const articles = published.map((p) => ({
  '@type': 'ScholarlyArticle',
  '@id': `${site}publications/#${p.id}`,
  headline: p.data.title,
  name: p.data.title,
  datePublished: String(p.data.year),
  isPartOf: { '@type': 'Periodical', name: p.data.venue },
  author: p.data.authors.map((name) =>
    name === SELF ? { '@type': 'Person', '@id': personId, name } : { '@type': 'Person', name },
  ),
  ...(p.data.doi && { sameAs: `https://doi.org/${p.data.doi}`, identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: p.data.doi } }),
  ...(p.data.arxiv && { sameAs: `https://arxiv.org/abs/${p.data.arxiv}` }),
  ...(p.data.abstract && { abstract: p.data.abstract }),
}));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${site}publications/`,
  name: 'Publications',
  about: { '@type': 'Person', '@id': personId, name: SELF },
  hasPart: articles,
};
---

<BaseLayout title="Publications" description="Papers and preprints by Thomas Konstantinovsky." jsonLd={jsonLd}>
  <div class:list={['intro', { 'with-journals': journals.length > 0 }]}>
    <div>
      <h1>Publications</h1>
      <p class="lede">
        Click a title for authors, abstract and links. † joint first authors.
        {profile?.data.links.scholar && <>{' '}Full list on <a href={profile.data.links.scholar} rel="noopener">Google Scholar</a>.</>}
      </p>
    </div>
    {journals.length > 0 && (
      <aside class="journals" aria-labelledby="journals-heading">
        <h2 id="journals-heading">Published in</h2>
        <dl>
          {journals.map(([name, { count }]) => (
            <div class="journal">
              <dt>{name}</dt>
              <dd>{count}<span class="sr-only"> {count === 1 ? 'article' : 'articles'}</span></dd>
            </div>
          ))}
        </dl>
        <p class="journal-total">{journalArticles.length} journal {journalArticles.length === 1 ? 'article' : 'articles'}</p>
      </aside>
    )}
  </div>

  <section class="group">
    <h2><span>First-author papers</span><span class="mono count">{first.length}</span></h2>
    {first.map((pub) => <PublicationRow pub={pub} />)}
  </section>

  <section class="group">
    <h2><span>Co-authored papers</span><span class="mono count">{coauthored.length}</span></h2>
    {coauthored.map((pub) => <PublicationRow pub={pub} />)}
  </section>

  {earlier.length > 0 && (
    <section class="group">
      <h2><span>Earlier work</span><span class="mono count">{earlier.length}</span></h2>
      {earlier.map((pub) => <PublicationRow pub={pub} />)}
    </section>
  )}

  {inPrep.length > 0 && (
    <section class="group">
      <h2><span>In preparation</span><span class="mono count">{inPrep.length}</span></h2>
      {inPrep.map((pub) => <PublicationRow pub={pub} />)}
    </section>
  )}
</BaseLayout>

<style>
  .intro { display: grid; gap: var(--space-7); align-items: start; }
  .intro.with-journals { grid-template-columns: minmax(0, 1fr) minmax(0, 21rem); }
  .lede { color: var(--muted); margin: var(--space-2) 0 0; }
  .journals { border-left: 1px solid var(--rule); padding-left: var(--space-5); }
  .journals h2 { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 500; line-height: 1.6; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .journals dl { display: grid; gap: var(--space-2); margin: var(--space-3) 0; }
  .journal { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-4); align-items: baseline; font-size: var(--text-sm); line-height: 1.4; }
  .journal dd { margin: 0; color: var(--accent); font-family: var(--font-mono); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }
  .journal-total { margin: 0; font-size: var(--text-xs); color: var(--muted); }
  .group { margin-top: var(--space-7); }
  .group h2 {
    display: flex; align-items: baseline; gap: var(--space-3);
    font-size: var(--text-lg); font-variation-settings: 'SOFT' 100, 'opsz' 24;
    padding-bottom: var(--space-3); margin-bottom: var(--space-1);
    border-bottom: 2px solid var(--ink);
  }
  .count { color: var(--muted); }
  @media (max-width: 860px) {
    .intro.with-journals { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
    .journals { width: 100%; max-width: 25rem; border-left: 0; border-top: 1px solid var(--rule); padding: var(--space-4) 0 0; }
  }
</style>
