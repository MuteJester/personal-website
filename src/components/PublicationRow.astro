---
import type { CollectionEntry } from 'astro:content';
import { arxivUrl, doiUrl, pubmedUrl, splitAuthors } from '../lib/format';
import { withBase } from '../lib/url';

interface Props { pub: CollectionEntry<'publications'> }
const { pub } = Astro.props;
const d = pub.data;
const authors = splitAuthors(d.authors);
const draft = d.status === 'in-preparation';
const links = [
  !draft && d.doi && { label: 'DOI', href: doiUrl(d.doi) },
  !draft && d.arxiv && { label: 'arXiv', href: arxivUrl(d.arxiv) },
  !draft && d.pmid && { label: 'PubMed', href: pubmedUrl(d.pmid) },
  !draft && d.pdf && { label: 'PDF', href: withBase(d.pdf) },
  d.code && { label: 'Code', href: d.code },
  d.app && { label: 'Web app', href: d.app },
  d.url && { label: 'Link', href: d.url },
].filter(Boolean) as { label: string; href: string }[];
const venue = d.venueShort ?? d.venue;
const tag = d.status === 'preprint' ? 'Preprint' : undefined;
---

<details class="row" id={pub.id}>
  <summary>
    <span class="mono year">{d.year}</span>
    <span class="title">{d.title}</span>
    <span class="venue"><em>{venue}</em>{tag && <span class="mono tag">{tag}</span>}</span>
    <span class="chev" aria-hidden="true"></span>
  </summary>
  <div class="body">
    <p class="authors">
      {authors.map((a, i) => (
        <>
          {a.self ? <strong>{a.name}</strong> : a.name}{d.equalContribution && i < d.equalContributors ? <sup title="Equal contribution">†</sup> : null}{i < authors.length - 1 ? ', ' : ''}
        </>
      ))}
    </p>
    {d.venueShort && <p class="fullvenue">{d.venue}</p>}
    {d.abstract && <p class="abstract">{d.abstract}</p>}
    {links.length > 0 && (
      <ul class="links">{links.map((l) => <li><a href={l.href} rel="noopener">{l.label}</a></li>)}</ul>
    )}
  </div>
</details>

<style>
  .row { border-bottom: 1px solid var(--rule); scroll-margin-top: var(--space-6); }
  .row:first-of-type { border-top: 0; }
  summary {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto 1rem;
    column-gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) var(--space-2);
    margin-inline: calc(-1 * var(--space-2));
    border-radius: 8px;
    cursor: pointer;
    list-style: none;
    transition: background-color var(--ease);
  }
  summary:hover { background: var(--accent-soft); }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .title { font-family: var(--font-body); font-size: var(--text-base); font-weight: 600; line-height: 1.35; }
  .venue { color: var(--muted); font-size: var(--text-sm); white-space: nowrap; display: flex; gap: var(--space-2); align-items: baseline; }
  .tag { color: var(--accent); }
  .chev { width: 0.5rem; height: 0.5rem; border-right: 1.5px solid var(--muted); border-bottom: 1.5px solid var(--muted); transform: rotate(45deg); transition: transform var(--ease); justify-self: end; margin-top: -0.2rem; }
  .row[open] .chev { transform: rotate(-135deg); margin-top: 0.2rem; }
  .body { padding: var(--space-2) 0 var(--space-5) calc(3.5rem + var(--space-4)); }
  .authors, .fullvenue { font-size: var(--text-sm); color: var(--muted); margin-bottom: var(--space-2); }
  .authors strong { color: var(--ink); font-weight: 600; }
  .fullvenue { font-style: italic; }
  .abstract { font-size: var(--text-sm); margin-bottom: var(--space-3); }
  .links { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .links a { font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.04em; }
  @media (max-width: 720px) {
    summary { grid-template-columns: minmax(0, 1fr) 1rem; row-gap: var(--space-1); }
    .year { grid-column: 1; }
    .title { grid-column: 1; }
    .venue { grid-column: 1; white-space: normal; }
    .chev { grid-column: 2; grid-row: 1; }
    .body { padding-left: 0; }
  }
</style>
