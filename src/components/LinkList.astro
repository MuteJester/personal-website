---
interface Props { links: { label: string; href: string; external?: boolean }[] }
const { links } = Astro.props;
---
<ul class="links">
  {links.map((l) => (
    <li><a href={l.href} rel={l.external ? 'noopener' : undefined} target={l.external ? '_blank' : undefined}>{l.label}</a></li>
  ))}
</ul>
<style>
  .links { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--space-2) var(--space-4); flex-wrap: wrap; }
  .links a { font-family: var(--font-mono); font-size: var(--text-sm); }
</style>
