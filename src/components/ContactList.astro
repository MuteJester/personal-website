---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props { profile: CollectionEntry<'profile'> }
const { data } = Astro.props.profile;

const icons: Record<string, string> = {
  mail: '<path d="M3 5h18v14H3z"/><path d="m3 7 9 6 9-6"/>',
  orcid: '<circle cx="12" cy="12" r="9"/><path d="M9 8v8M9 6.5v.1M12.5 8h2.2a4 4 0 0 1 0 8h-2.2z"/>',
  scholar: '<path d="M2 10 12 5l10 5-10 5z"/><path d="M6 12v4c0 1.5 3 3 6 3s6-1.5 6-3v-4"/><path d="M22 10v5"/>',
  github: '<path d="M9 19c-4 1.5-4-2-6-2m12 4v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.7 11.7 0 0 0-6 0C6.8 2.8 5.8 3.1 5.8 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4.4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  pdf: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h5"/>',
};
const items = [
  { icon: 'mail', label: data.email, href: `mailto:${data.email}` },
  data.links.orcid && { icon: 'orcid', label: 'ORCID', href: data.links.orcid, external: true },
  data.links.scholar && { icon: 'scholar', label: 'Google Scholar', href: data.links.scholar, external: true },
  data.links.github && { icon: 'github', label: 'GitHub', href: data.links.github, external: true },
  data.links.linkedin && { icon: 'linkedin', label: 'LinkedIn', href: data.links.linkedin, external: true },
  data.cvPdf && { icon: 'pdf', label: 'Curriculum vitae (PDF)', href: withBase(data.cvPdf) },
].filter(Boolean) as { icon: string; label: string; href: string; external?: boolean }[];
---

<ul class="contact">
  {items.map((it) => (
    <li>
      <a href={it.href} rel={it.external ? 'noopener' : undefined}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[it.icon]} />
        <span>{it.label}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .contact { list-style: none; margin: 0; padding: 0; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--paper-2); overflow: hidden; }
  .contact li + li { border-top: 1px solid var(--rule); }
  .contact a { display: flex; align-items: center; gap: var(--space-3); padding: 0.6rem var(--space-4); color: var(--ink); text-decoration: none; font-size: var(--text-sm); transition: background-color var(--ease); }
  .contact a:hover { background: var(--accent-soft); color: var(--accent); }
  .contact svg { flex: none; color: var(--muted); }
  .contact a:hover svg { color: var(--accent); }
</style>
