---
interface Props { title: string; number?: string; id?: string; align?: 'gutter' | 'center' }
const { title, number, id, align = 'gutter' } = Astro.props;
---
<div class={`head ${align === 'center' ? 'center' : 'grid'}`} id={id}>
  <span class="mono num" aria-hidden="true">{number ?? ''}</span>
  <h2>{title}</h2>
</div>
<style>
  .head { align-items: baseline; padding-block: var(--space-6) var(--space-4); border-top: 1px solid var(--rule); }
  .head.center { text-align: center; padding-block: var(--space-7) var(--space-5); }
  .head.center .num { display: none; }
  .num { color: var(--accent); }
  @media (max-width: 720px) { .head { row-gap: var(--space-1); } .num:empty { display: none; } }
</style>
