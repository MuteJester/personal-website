---
import type { CollectionEntry } from 'astro:content';
import { formatMonthYear } from '../lib/format';

interface Props { patent: CollectionEntry<'patents'> }
const { id, data } = Astro.props.patent;
const status = data.status === 'granted' ? 'Granted' : 'Pending';
---

<details class="row" id={`patent-${id}`}>
  <summary>
    <span class="mono year">{data.date.getUTCFullYear()}</span>
    <span class="title">{data.title}</span>
    <span class="venue"><em>{data.status === 'granted' ? data.number : (data.note ?? 'Patent application')}</em><span class={`mono tag ${data.status}`}>{status}</span></span>
    <span class="chev" aria-hidden="true"></span>
  </summary>
  <div class="body">
    <p class="meta">Inventors: {data.inventors.join(', ')}</p>
    <p class="meta">{data.status === 'granted' ? `Granted ${formatMonthYear(data.date)}` : `Filed ${formatMonthYear(data.date)}`}{data.assignee && ` · Assignee: ${data.assignee}`}{data.office && ` · ${data.office}`}</p>
    {data.url && <ul class="links"><li><a href={data.url} rel="noopener">Patent record</a></li></ul>}
  </div>
</details>

<style>
  .row { border-bottom: 1px solid var(--rule); scroll-margin-top: var(--space-6); }
  summary {
    display: grid; grid-template-columns: 3.5rem minmax(0, 1fr) auto 1rem; column-gap: var(--space-4);
    align-items: baseline; padding: var(--space-4) var(--space-2); margin-inline: calc(-1 * var(--space-2));
    border-radius: 8px; cursor: pointer; list-style: none; transition: background-color var(--ease);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: var(--accent-soft); }
  summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .title { font-family: var(--font-body); font-size: var(--text-base); font-weight: 600; line-height: 1.35; }
  .venue { color: var(--muted); font-size: var(--text-sm); white-space: nowrap; display: flex; gap: var(--space-2); align-items: baseline; }
  .tag.granted { color: var(--accent); }
  .chev { width: 0.5rem; height: 0.5rem; border-right: 1.5px solid var(--muted); border-bottom: 1.5px solid var(--muted); transform: rotate(45deg); transition: transform var(--ease); justify-self: end; margin-top: -0.2rem; }
  .row[open] .chev { transform: rotate(-135deg); margin-top: 0.2rem; }
  .body { padding: var(--space-2) 0 var(--space-5) calc(3.5rem + var(--space-4)); }
  .meta { font-size: var(--text-sm); color: var(--muted); margin-bottom: var(--space-2); }
  .links { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--space-4); }
  .links a { font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.04em; }
  @media (max-width: 720px) {
    summary { grid-template-columns: minmax(0, 1fr) 1rem; row-gap: var(--space-1); }
    .year, .title, .venue { grid-column: 1; }
    .venue { white-space: normal; }
    .chev { grid-column: 2; grid-row: 1; }
    .body { padding-left: 0; }
  }
</style>
