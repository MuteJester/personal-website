---
import { getCollection } from 'astro:content';
import { formatDateRange, formatMonthYear } from '../lib/format';
const items = (await getCollection('awards', (a) => Boolean(a.data.highlight)))
  .sort((a, b) => a.data.highlight!.order - b.data.highlight!.order);
---
<ul class="fellowships">
  {items.map(({ data }) => (
    <li>
      <span class="mono when">{data.end ? formatDateRange(data.date, data.end) : formatMonthYear(data.date)}</span>
      <div>
        <p class="title">{data.title}</p>
        <p class="issuer">{data.issuer}</p>
      </div>
    </li>
  ))}
</ul>
<style>
  .fellowships { list-style: none; margin: 0; padding: 0; }
  .fellowships li { display: grid; grid-template-columns: 7rem minmax(0, 1fr); column-gap: var(--space-4); align-items: baseline; padding-block: var(--space-3); border-bottom: 1px solid var(--rule); }
  .when { font-size: var(--text-xs); }
  .title { font-weight: 600; font-size: var(--text-base); margin: 0 0 0.15rem; max-width: none; }
  .issuer { font-size: var(--text-sm); color: var(--muted); margin: 0; max-width: none; }
  @media (max-width: 560px) { .fellowships li { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-1); } }
</style>
