---
import type { CollectionEntry } from 'astro:content';
import { formatMonthYear } from '../lib/format';
interface Props { items: CollectionEntry<'news'>[] }
const { items } = Astro.props;
---
<ul class="news">
  {items.map(({ data }) => (
    <li class="grid">
      <span class="mono">{formatMonthYear(data.date)}</span>
      <span>{data.url ? <a href={data.url} rel="noopener">{data.text}</a> : data.text}</span>
    </li>
  ))}
</ul>
<style>
  .news { list-style: none; margin: 0; padding: 0; }
  .news li { padding-block: var(--space-3); border-top: 1px solid var(--rule); font-size: var(--text-sm); }
</style>
