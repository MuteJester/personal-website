---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ContactList from './ContactList.astro';
import portrait from '../assets/images/portrait-hero.jpg';

interface Props { profile: CollectionEntry<'profile'> }
const { data } = Astro.props.profile;
const [role, ...rest] = data.affiliation.split(' · ');
const affiliation = rest.join(' · ');
---

<section class="hero">
  <div class="text">
    <p class="identity">
      <strong>{role}</strong>
      {affiliation && <span>{affiliation}</span>}
    </p>
    <h1 class="name">{data.name}</h1>
    <p class="headline">{data.headline}</p>
    <p class="bio">{data.bio}</p>
  </div>
  <aside class="side">
    <figure class="media">
      <Image src={portrait} alt={data.hero.alt} width={720} class="still" loading="eager" />
      {data.heroCaption && <figcaption>{data.heroCaption}</figcaption>}
    </figure>
    <ContactList profile={Astro.props.profile} />
  </aside>
</section>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 3fr) minmax(16rem, 2fr);
    gap: var(--space-7); align-items: start; padding-block: var(--space-6) var(--space-7);
  }
  .identity { display: grid; gap: 0.1rem; margin-bottom: var(--space-4); padding-left: var(--space-3); border-left: 2px solid var(--accent); font-size: var(--text-sm); max-width: none; }
  .identity strong { color: var(--ink); font-weight: 600; }
  .identity span { color: var(--muted); }
  .name { font-size: var(--text-hero); font-variation-settings: 'SOFT' 100, 'opsz' 144; letter-spacing: -0.02em; margin-bottom: var(--space-3); }
  .headline { font-family: var(--font-display); font-size: var(--text-lg); font-variation-settings: 'SOFT' 100; color: var(--muted); margin-bottom: var(--space-5); max-width: 34rem; }
  .bio { margin-bottom: 0; }
  .side { display: grid; gap: var(--space-4); max-width: 22rem; justify-self: end; width: 100%; }
  .media { margin: 0; }
  .still { width: 100%; height: auto; aspect-ratio: 900 / 1066; object-fit: cover; border-radius: var(--radius); border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--rule)); }
  figcaption { margin-top: var(--space-2); font-size: var(--text-xs); color: var(--muted); }
  @media (max-width: 860px) {
    .hero { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
    .side { max-width: none; justify-self: stretch; grid-template-columns: minmax(0, 16rem) minmax(0, 1fr); align-items: start; }
  }
  @media (max-width: 560px) {
    .side { grid-template-columns: minmax(0, 1fr); }
    .media { max-width: 16rem; }
  }
</style>
