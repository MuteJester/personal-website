---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';
import LinkList from './LinkList.astro';

interface Props { profile: CollectionEntry<'profile'> }
const { data } = Astro.props.profile;
const links = [
  { label: data.email, href: `mailto:${data.email}` },
  data.links.scholar && { label: 'Scholar', href: data.links.scholar, external: true },
  data.links.orcid && { label: 'ORCID', href: data.links.orcid, external: true },
  data.links.github && { label: 'GitHub', href: data.links.github, external: true },
  data.links.linkedin && { label: 'LinkedIn', href: data.links.linkedin, external: true },
  data.cvPdf && { label: 'CV (PDF)', href: withBase(data.cvPdf) },
].filter(Boolean) as { label: string; href: string; external?: boolean }[];
---

<section class="hero">
  <div class="text">
    <p class="mono kicker">{data.affiliation}</p>
    <h1 class="name">{data.name}</h1>
    <p class="headline">{data.headline}</p>
    <p class="bio">{data.bio}</p>
    {data.credentials.length > 0 && (
      <ul class="creds">{data.credentials.map((c) => <li>{c}</li>)}</ul>
    )}
    <LinkList links={links} />
  </div>
  <figure class="media">
    <video
      class="loop"
      autoplay muted loop playsinline preload="metadata"
      poster={withBase(data.hero.poster)}
      aria-label={data.hero.alt}
    >
      <source media="(prefers-reduced-motion: no-preference)" src={withBase(data.hero.webm)} type="video/webm" />
      <source media="(prefers-reduced-motion: no-preference)" src={withBase(data.hero.mp4)} type="video/mp4" />
    </video>
    <img class="still" src={withBase(data.hero.poster)} alt={data.hero.alt} width="496" height="588" />
    {data.heroCaption && <figcaption class="mono">{data.heroCaption}</figcaption>}
  </figure>
</section>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-7); align-items: start; padding-block: var(--space-6) var(--space-7);
  }
  .kicker { margin-bottom: var(--space-3); color: var(--accent); }
  .name { font-size: var(--text-hero); font-variation-settings: 'SOFT' 100, 'opsz' 144; letter-spacing: -0.02em; margin-bottom: var(--space-3); }
  .headline { font-family: var(--font-display); font-size: var(--text-lg); font-variation-settings: 'SOFT' 100; color: var(--ink); margin-bottom: var(--space-4); max-width: 34rem; }
  .bio { margin-bottom: var(--space-4); }
  .creds { list-style: none; padding: 0; margin: 0 0 var(--space-5); border-left: 2px solid var(--accent); padding-left: var(--space-3); font-size: var(--text-sm); color: var(--muted); display: grid; gap: var(--space-1); }
  .media { margin: 0; max-width: 22rem; justify-self: end; width: 100%; }
  .loop, .still {
    width: 100%; aspect-ratio: 496 / 588; object-fit: cover; border-radius: var(--radius);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--rule));
  }
  .loop { animation: fade 250ms ease-out both; }
  .still { display: none; }
  figcaption { margin-top: var(--space-2); text-transform: none; letter-spacing: 0; }
  @keyframes fade { from { opacity: 0 } to { opacity: 1 } }
  @media (prefers-reduced-motion: reduce) {
    .loop { display: none; }
    .still { display: block; }
  }
  @media (max-width: 720px) {
    .hero { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
    .media { max-width: 16rem; justify-self: start; }
  }
</style>
