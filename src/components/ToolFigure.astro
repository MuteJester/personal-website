---
// Small explanatory figures for the research software, drawn in the site's palette.
interface Props { kind: 'simulate' | 'align' | 'graph'; title: string }
const { kind, title } = Astro.props;
---
{kind === 'simulate' && (
  <svg viewBox="0 0 260 150" role="img" aria-label={title} class="fig">
    <title>{title}</title>
    <g class="ink" font-family="var(--font-mono)" font-size="9">
      <text x="10" y="18">germline</text>
      <text x="10" y="86">simulated read</text>
    </g>
    <g class="seg-v"><rect x="10" y="26" width="120" height="14" rx="2"/><text x="64" y="37" class="lbl">V</text></g>
    <g class="seg-d"><rect x="146" y="26" width="34" height="14" rx="2"/><text x="160" y="37" class="lbl">D</text></g>
    <g class="seg-j"><rect x="196" y="26" width="54" height="14" rx="2"/><text x="219" y="37" class="lbl">J</text></g>
    <g class="arrows" stroke-width="1" fill="none"><path d="M70 42 v46"/><path d="M163 42 v46"/><path d="M223 42 v46"/></g>
    <g class="seg-v"><rect x="10" y="94" width="104" height="14" rx="2"/></g>
    <g class="ins"><rect x="116" y="94" width="18" height="14" rx="2"/><text x="119" y="128" class="tiny">N1</text></g>
    <g class="seg-d"><rect x="136" y="94" width="30" height="14" rx="2"/></g>
    <g class="ins"><rect x="168" y="94" width="14" height="14" rx="2"/><text x="167" y="128" class="tiny">N2</text></g>
    <g class="seg-j"><rect x="184" y="94" width="66" height="14" rx="2"/></g>
    <g class="mut"><rect x="31" y="92" width="3" height="18"/><rect x="58" y="92" width="3" height="18"/><rect x="92" y="92" width="3" height="18"/><rect x="215" y="92" width="3" height="18"/></g>
    <g class="ink" font-family="var(--font-mono)" font-size="8"><text x="10" y="142">V(D)J recombination, N insertions, mutations</text></g>
  </svg>
)}
{kind === 'align' && (
  <svg viewBox="0 0 260 150" role="img" aria-label={title} class="fig">
    <title>{title}</title>
    <g class="ink" font-family="var(--font-mono)" font-size="9">
      <text x="10" y="18">read</text>
      <text x="10" y="60">alignment</text>
      <text x="10" y="112">confidence</text>
    </g>
    <g class="strand"><rect x="10" y="24" width="240" height="10" rx="2"/></g>
    <g class="seg-v"><rect x="10" y="66" width="110" height="14" rx="2"/><text x="60" y="77" class="lbl">V</text></g>
    <g class="seg-d"><rect x="128" y="66" width="40" height="14" rx="2"/><text x="144" y="77" class="lbl">D</text></g>
    <g class="seg-j"><rect x="176" y="66" width="74" height="14" rx="2"/><text x="209" y="77" class="lbl">J</text></g>
    <g class="cut" stroke-width="1.5"><path d="M120 60 v26"/><path d="M128 60 v26"/><path d="M168 60 v26"/><path d="M176 60 v26"/></g>
    <g class="track"><rect x="10" y="120" width="240" height="8" rx="4"/></g>
    <g class="fill"><rect x="10" y="120" width="216" height="8" rx="4"/></g>
    <g class="ink" font-family="var(--font-mono)" font-size="8"><text x="10" y="142">gene calls with calibrated likelihoods</text></g>
  </svg>
)}
{kind === 'graph' && (
  <svg viewBox="0 0 260 150" role="img" aria-label={title} class="fig">
    <title>{title}</title>
    <g class="ink" font-family="var(--font-mono)" font-size="9"><text x="10" y="18">CASSLGQAYEQYF</text></g>
    <g class="edges" fill="none" stroke-width="1.2">
      <path d="M30 80 C 60 40, 80 40, 100 60"/><path d="M30 80 C 60 110, 80 110, 100 100"/>
      <path d="M100 60 C 130 50, 150 50, 170 70"/><path d="M100 100 C 130 90, 150 90, 170 70"/>
      <path d="M100 60 C 130 80, 150 90, 170 110"/><path d="M170 70 C 200 60, 220 60, 240 80"/><path d="M170 110 C 200 100, 220 90, 240 80"/>
    </g>
    <g class="edge-hi" fill="none" stroke-width="2.5"><path d="M30 80 C 60 40, 80 40, 100 60"/><path d="M100 60 C 130 50, 150 50, 170 70"/><path d="M170 70 C 200 60, 220 60, 240 80"/></g>
    <g class="node"><circle cx="30" cy="80" r="6"/><circle cx="100" cy="60" r="6"/><circle cx="100" cy="100" r="6"/><circle cx="170" cy="70" r="6"/><circle cx="170" cy="110" r="6"/><circle cx="240" cy="80" r="6"/></g>
    <g class="ink" font-family="var(--font-mono)" font-size="8">
      <text x="22" y="98">C</text><text x="92" y="50">AS</text><text x="90" y="118">SL</text><text x="160" y="60">GQ</text><text x="160" y="128">AY</text><text x="232" y="98">F</text>
      <text x="10" y="142">walk probability = product of edge weights</text>
    </g>
  </svg>
)}
<style>
  .fig { width: 100%; height: auto; display: block; }
  .ink { fill: var(--muted); }
  .lbl { fill: var(--paper); font-family: var(--font-mono); font-size: 9px; font-weight: 600; text-anchor: middle; }
  .tiny { fill: var(--muted); font-family: var(--font-mono); font-size: 8px; }
  .seg-v rect { fill: var(--accent); }
  .seg-d rect { fill: color-mix(in srgb, var(--accent) 55%, var(--ink)); }
  .seg-j rect { fill: color-mix(in srgb, var(--accent) 60%, var(--paper)); }
  .seg-j .lbl { fill: var(--ink); }
  .ins rect { fill: var(--rule); }
  .mut rect { fill: var(--chart-industry); }
  .arrows path, .cut path { stroke: var(--muted); stroke-dasharray: 2 3; }
  .cut path { stroke: var(--chart-industry); stroke-dasharray: none; }
  .strand rect { fill: var(--rule); }
  .track rect { fill: var(--rule); }
  .fill rect { fill: var(--chart-teaching); }
  .edges path { stroke: var(--rule); }
  .edge-hi path { stroke: var(--accent); }
  .node circle { fill: var(--paper); stroke: var(--ink); stroke-width: 1.5; }
</style>
