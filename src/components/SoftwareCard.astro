---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';
interface Props { project: CollectionEntry<'projects'> }
const { id, data } = Astro.props.project;
const links = [
  { label: 'Repository', href: data.repo },
  data.docs && { label: 'Docs', href: data.docs },
  data.app && { label: 'Web app', href: data.app },
  data.pypi && { label: 'PyPI', href: `https://pypi.org/project/${data.pypi}/` },
  data.paper && { label: 'Paper', href: `${withBase('publications/')}#${data.paper}` },
].filter(Boolean) as { label: string; href: string }[];
---
<article class="card" id={id}>
  <h3>{data.name}</h3>
  <p class="tagline">{data.tagline}</p>
  <p class="desc">{data.description}</p>
  {data.pypi && <code class="install">pip install {data.pypi}</code>}
  <ul class="links">{links.map((l) => <li><a href={l.href} rel="noopener">{l.label}</a></li>)}</ul>
</article>
<style>
  .card { padding: var(--space-5); border: 1px solid var(--rule); border-radius: var(--radius); background: var(--paper-2); display: flex; flex-direction: column; gap: var(--space-2); scroll-margin-top: var(--space-6); }
  h3 { font-family: var(--font-display); font-weight: 500; font-size: var(--text-lg); }
  .tagline { color: var(--muted); font-size: var(--text-sm); margin: 0; }
  .desc { font-size: var(--text-sm); margin: 0; flex: 1; }
  .install { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--ink); background: var(--paper); border: 1px solid var(--rule); border-radius: 6px; padding: var(--space-1) var(--space-2); align-self: flex-start; }
  .links { list-style: none; margin: var(--space-2) 0 0; padding: 0; display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .links a { font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.04em; }
</style>
